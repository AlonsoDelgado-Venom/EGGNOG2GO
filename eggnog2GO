# ==============================================================================
# SECTION 3: LOAD KALLISTO DATA
# ==============================================================================

cat("=== Loading Kallisto data ===\n")

files <- paste0("kallisto_out_", tissues, "/abundance.tsv")
names(files) <- tissues

# Verify all files exist before proceeding
file_check <- file.exists(files)
print(data.frame(tissue = tissues, path = files, found = file_check))
if (!all(file_check)) stop("Missing kallisto files — check folder names")

# Sample metadata
sample_table <- data.frame(
  sample_name = tissues,
  condition   = tissues,
  venom       = c("venom", "non_venom", "venom",
                  "non_venom", "non_venom", "non_venom"),
  row.names   = tissues
)

# Load transcript-to-gene mapping
tx2gene <- read.table("tx2gene.tsv", header = TRUE, sep = "\t")

# Import kallisto quantification
txi <- tximport(
  files,
  type            = "kallisto",
  tx2gene         = tx2gene,
  ignoreTxVersion = TRUE
)

cat(sprintf("Genes imported: %d\n", nrow(txi$counts)))
cat(sprintf("Samples: %s\n", paste(colnames(txi$counts), collapse = ", ")))


# ==============================================================================
# SECTION 4: NORMALIZE COUNTS
# ==============================================================================

cat("\n=== Normalizing counts ===\n")

dds_norm <- DESeqDataSetFromTximport(txi,
                                      colData = sample_table,
                                      design  = ~ 1)
dds_norm          <- estimateSizeFactors(dds_norm)
normalized_counts <- counts(dds_norm, normalized = TRUE)

df_norm <- as.data.frame(normalized_counts) %>%
  rownames_to_column("Gene_ID")

write.csv(df_norm, "ALL_T_pacificus_Normalized_Genes.csv", row.names = FALSE)
cat("Saved: ALL_T_pacificus_Normalized_Genes.csv\n")

# Extract gene IDs for matching
expr_ids <- rownames(normalized_counts)
cat(sprintf("Total expression genes: %d\n", length(expr_ids)))


# ==============================================================================
# SECTION 5: VARIANCE STABILIZING TRANSFORMATION + FOLD CHANGE FILTER
# ==============================================================================

cat("\n=== VST transformation and fold change calculation ===\n")

dds_vst <- DESeqDataSetFromTximport(txi,
                                     colData = sample_table,
                                     design  = ~ 1)
dds_vst <- dds_vst[rowSums(counts(dds_vst)) >= 10, ]
dds_vst <- estimateSizeFactors(dds_vst)
vst_mat <- varianceStabilizingTransformation(dds_vst, blind = TRUE)

# Calculate expression range across tissues (log2 scale)
vst_df <- as.data.frame(assay(vst_mat)) %>%
  rownames_to_column("Gene_ID")

vst_fc <- vst_df %>%
  rowwise() %>%
  mutate(
    max_vst    = max(c_across(all_of(tissues)), na.rm = TRUE),
    min_vst    = min(c_across(all_of(tissues)), na.rm = TRUE),
    range_log2 = max_vst - min_vst,
    tissue_max = tissues[which.max(c_across(all_of(tissues)))],
    tissue_min = tissues[which.min(c_across(all_of(tissues)))]
  ) %>%
  ungroup()

# Genes with >= 1 log2 fold change (2-fold) across any tissue
genes_1xFC <- vst_fc %>%
  filter(range_log2 >= 1) %>%
  pull(Gene_ID)

cat(sprintf("Total VST genes:              %d\n", nrow(vst_fc)))
cat(sprintf("Genes with >=2-fold variation: %d\n", length(genes_1xFC)))


# ==============================================================================
# SECTION 6: LOAD AND PROCESS EGGNOG ANNOTATIONS
# ==============================================================================

cat("\n=== Loading EggNOG annotations ===\n")

# Helper: load a single EggNOG annotation file
load_eggnog <- function(filepath, tissue_label = NULL) {
  df <- read.table(
    filepath,
    header       = FALSE,
    sep          = "\t",
    comment.char = "#",
    quote        = "",
    fill         = TRUE,
    na.strings   = c("", "-")
  )
  n_cols <- min(ncol(df), length(eggnog_cols))
  colnames(df)[1:n_cols] <- eggnog_cols[1:n_cols]
  if (!is.null(tissue_label)) df$source_tissue <- tissue_label
  return(df)
}

# Build file paths and verify
eggnog_files <- paste0("T_pacificus_", tissue_name_map$eggnog_name,
                        "_mmseqs.emapper.annotations")
names(eggnog_files) <- tissue_name_map$kallisto_name

cat("EggNOG files:\n")
for (i in seq_along(eggnog_files)) {
  cat(sprintf("  %-8s : [%s]\n",
              names(eggnog_files)[i],
              ifelse(file.exists(eggnog_files[i]), "FOUND", "MISSING")))
}

# Load all tissue-specific EggNOG files
eggnog_tissue_list <- list()
for (i in seq_len(nrow(tissue_name_map))) {
  kal_name <- tissue_name_map$kallisto_name[i]
  filepath <- eggnog_files[kal_name]
  if (file.exists(filepath)) {
    eggnog_tissue_list[[kal_name]] <- load_eggnog(filepath,
                                                    tissue_label = kal_name)
    cat(sprintf("  Loaded %-8s: %d entries\n",
                kal_name, nrow(eggnog_tissue_list[[kal_name]])))
  }
}

# Combine and clean Gene IDs
# EggNOG IDs have format: "TP_BM_TRINITY_DN44329_c0_g1_i1.p2"
# Expression IDs have format: "TRINITY_DN44329_c0_g1"
eggnog_combined <- bind_rows(eggnog_tissue_list) %>%
  mutate(
    Gene_ID_original = Gene_ID,
    Gene_ID_clean    = gsub("^TP_[A-Za-z]+_", "", Gene_ID),
    Gene_ID_clean    = gsub("_i[0-9]+\\.p[0-9]+$", "", Gene_ID_clean)
  )

# Report match rate
after_match <- sum(eggnog_combined$Gene_ID_clean %in% expr_ids)
cat(sprintf("\nID match rate after cleaning: %d / %d (%.1f%%)\n",
            after_match, nrow(eggnog_combined),
            100 * after_match / nrow(eggnog_combined)))

# Deduplicate: keep best hit (lowest evalue) per gene
eggnog_dedup <- eggnog_combined %>%
  filter(Gene_ID_clean %in% expr_ids) %>%
  mutate(
    Gene_ID = Gene_ID_clean,
    evalue  = suppressWarnings(as.numeric(evalue))
  ) %>%
  arrange(evalue) %>%
  group_by(Gene_ID) %>%
  slice(1) %>%
  ungroup() %>%
  select(-Gene_ID_original, -Gene_ID_clean)

# Filter to genes with >=2-fold variation
eggnog_final <- eggnog_dedup %>%
  filter(Gene_ID %in% genes_1xFC)

cat(sprintf("Unique annotated genes:              %d\n", nrow(eggnog_dedup)))
cat(sprintf("Annotated + >=2-fold variable genes: %d\n", nrow(eggnog_final)))

# Save
write.csv(eggnog_dedup,  "eggnog_all_genes_annotated.csv",    row.names = FALSE)
write.csv(eggnog_final,  "eggnog_filtered_2fold_annotated.csv", row.names = FALSE)
cat("Saved: eggnog_all_genes_annotated.csv\n")
cat("Saved: eggnog_filtered_2fold_annotated.csv\n")


