# --- PLOT 3: GSEA Running Score Plots ---

plot_running_scores <- function(gsea_result, n_terms = 6,
                                  direction = "both") {

  if (is.null(gsea_result) ||
      nrow(as.data.frame(gsea_result)) == 0) return(list())

  df <- as.data.frame(gsea_result) %>% arrange(p.adjust)

  if (direction == "positive") df <- filter(df, NES > 0)
  if (direction == "negative") df <- filter(df, NES < 0)
  if (nrow(df) == 0) return(list())

  top_ids <- slice(df, 1:min(n_terms, nrow(df))) %>% pull(ID)

  plots <- lapply(top_ids, function(term_id) {
    info <- filter(df, ID == term_id)[1, ]
    tryCatch(
      gseaplot2(
        gsea_result,
        geneSetID = term_id,
        title     = str_wrap(
          sprintf("%s\nNES=%.3f | p.adj=%.3g",
                  info$Description, info$NES, info$p.adjust),
          width = 55
        ),
        color     = ifelse(info$NES > 0, "darkred", "steelblue"),
        base_size = 10
      ),
      error = function(e) NULL
    )
  })
  plots[!sapply(plots, is.null)]
}

