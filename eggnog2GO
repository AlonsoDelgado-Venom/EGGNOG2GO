go_ids_present <- unique(go_annotations$GO_ID)
term2gene_GO   <- go_annotations %>% select(GO_ID, Gene_ID)

cat(sprintf("Genes with GO terms: %d\n", n_distinct(go_annotations$Gene_ID)))
cat(sprintf("Unique GO terms:     %d\n", n_distinct(go_annotations$GO_ID)))

# Get GO term names and ontology from GO.db
cat("Looking up GO term names (1-2 minutes)...\n")
go_lookup <- lapply(go_ids_present, function(goid) {
  tryCatch({
    term_obj <- GOTERM[[goid]]
    if (!is.null(term_obj)) {
      data.frame(
        GO_ID       = goid,
        GO_name     = Term(term_obj),
        GO_ontology = Ontology(term_obj),
        stringsAsFactors = FALSE
      )
