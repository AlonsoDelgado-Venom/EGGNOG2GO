cat("\n=== Running GSEA ===\n")

# Core GSEA wrapper function
run_gsea <- function(gsea_vector, term2gene, term2name = NULL,
                      label = "comparison", pval = 0.20,
                      min_gs = 10, max_gs = 500) {

  cat(sprintf("  %-25s [%d genes] ... ", label, length(gsea_vector)))

  result <- tryCatch({
    GSEA(
      geneList      = gsea_vector,
      TERM2GENE     = term2gene,
      TERM2NAME     = term2name,
      minGSSize     = min_gs,
      maxGSSize     = max_gs,
      pvalueCutoff  = pval,
      pAdjustMethod = "BH",
      verbose       = FALSE,
      seed          = 42
    )
  }, error = function(e) {
    cat(sprintf("FAILED: %s\n", e$message))
    return(NULL)
  })

  if (!is.null(result)) {
    n  <- nrow(as.data.frame(result))
    nU <- sum(as.data.frame(result)$NES > 0, na.rm = TRUE)
    nD <- sum(as.data.frame(result)$NES < 0, na.rm = TRUE)
    cat(sprintf("%d terms (+%d / -%d)\n", n, nU, nD))
  }
  return(result)
}

