term2name_GO <- do.call(rbind, go_lookup[!sapply(go_lookup, is.null)])

# Split by ontology
term2name_BP <- term2name_GO %>% filter(GO_ontology == "BP")
term2name_MF <- term2name_GO %>% filter(GO_ontology == "MF")
term2name_CC <- term2name_GO %>% filter(GO_ontology == "CC")
term2gene_BP <- term2gene_GO %>% filter(GO_ID %in% term2name_BP$GO_ID)
term2gene_MF <- term2gene_GO %>% filter(GO_ID %in% term2name_MF$GO_ID)
term2gene_CC <- term2gene_GO %>% filter(GO_ID %in% term2name_CC$GO_ID)

