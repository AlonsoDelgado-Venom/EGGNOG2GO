cat("\n=== Section 13: Clustering venom genes ===\n")

# Scale VST values
venom_scaled <- t(scale(t(venom_vst)))

# Hierarchical clustering
gene_dist     <- dist(venom_scaled,  method = "euclidean")
gene_hclust   <- hclust(gene_dist,   method = "ward.D2")
n_clusters    <- 5
gene_clusters <- cutree(gene_hclust, k = n_clusters)

cluster_df <- data.frame(
  Gene_ID = names(gene_clusters),
  cluster = paste0("Cluster_", gene_clusters),
  stringsAsFactors = FALSE
)

cat("Genes per cluster:\n")
print(table(cluster_df$cluster))

# Add annotations and enrichment scores
cluster_annotated <- cluster_df %>%
  dplyr::left_join(
    all_venom_genes %>%
      dplyr::select(Gene_ID, Description, Preferred_name,
                    category, COG_category),
    by = "Gene_ID"
  ) %>%
  dplyr::left_join(
    venom_expr %>%
      dplyr::select(Gene_ID, PSG_enrichment,
                    ASG_enrichment, PSG_vs_ASG, max_tissue),
    by = "Gene_ID"
  )

# Characterize clusters
cluster_summary <- cluster_annotated %>%
  dplyr::group_by(cluster) %>%
  dplyr::summarise(
    n_genes         = n(),
    mean_PSG_enrich = round(mean(PSG_enrichment, na.rm = TRUE), 2),
    top_category    = names(sort(table(category), decreasing = TRUE))[1],
    n_venom_toxin   = sum(category == "Venom toxin", na.rm = TRUE),
    n_processing    = sum(category == "Processing",  na.rm = TRUE),
    .groups = "drop"
  ) %>%
  dplyr::mutate(
    cluster_label = case_when(
      mean_PSG_enrich > 1 &
        top_category == "Venom toxin"  ~ "PSG Toxins",
      mean_PSG_enrich > 1 &
        top_category == "Processing"   ~ "PSG Processing",
      mean_PSG_enrich > 0.5            ~ "PSG Moderate",
      mean_PSG_enrich < -0.5           ~ "ASG Enriched",
      TRUE                             ~ "Shared/Low"
    )
  )

cat("\nCluster summary:\n")
print(cluster_summary)

# Add labels back
cluster_annotated <- cluster_annotated %>%
  dplyr::left_join(
    cluster_summary %>% dplyr::select(cluster, cluster_label),
