# Helper: dotplot
clean_dotplot <- function(result, title,
                          n_show = 20, label_wrap = 40) {
  if (is.null(result) || nrow(as.data.frame(result)) == 0) {
    message("No terms to plot: ", title); return(NULL)
  }
  df <- as.data.frame(result) %>%
    arrange(p.adjust) %>%
    slice(1:min(n_show, nrow(.))) %>%
    mutate(
      direction   = ifelse(NES > 0,
                           "Enriched in PSG (+NES)",
                           "Enriched in ASG (-NES)"),
      Description = str_wrap(Description, width = label_wrap),
      Description = factor(Description,
                           levels = Description[order(NES)])
    )
  ggplot(df, aes(x = NES, y = Description,
                 size = setSize, color = p.adjust)) +
    geom_point(alpha = 0.85) +
    geom_vline(xintercept = 0, linetype = "dashed",
               color = "grey50") +
    scale_color_gradient(low = "firebrick", high = "grey80",
                         name = "Adj. p-value") +
    scale_size_continuous(name = "Gene set size", range = c(2, 10)) +
    facet_wrap(~ direction, scales = "free_x", ncol = 2) +
    theme_bw(base_size = 11) +
    labs(title = title,
         x     = "Normalized Enrichment Score (NES)",
         y     = NULL) +
    theme(
      plot.title       = element_text(hjust = 0.5, face = "bold", size = 12),
      axis.text.y      = element_text(size = 9),
      strip.text       = element_text(face = "bold", size = 10),
      strip.background = element_rect(fill = "grey92")
    )
}

# Helper: NES barplot
nes_barplot <- function(result, title,
                        tissue_pos = "PSG",
                        tissue_neg = "ASG",
                        n_show     = 25,
                        label_wrap = 45) {

  if (is.null(result) || nrow(as.data.frame(result)) == 0) return(NULL)

  df <- as.data.frame(result) %>%
    filter(p.adjust < 0.05) %>%
    arrange(NES)

  if (nrow(df) == 0) {
    message("No significant terms (p.adj<0.05): ", title); return(NULL)
  }

  n_neg <- min(n_show %/% 2, sum(df$NES < 0))
  n_pos <- min(n_show %/% 2, sum(df$NES > 0))

  df <- df %>%
    slice(c(1:n_neg, (nrow(.) - n_pos + 1):nrow(.))) %>%
    mutate(
      Description = str_wrap(Description, width = label_wrap),
      Description = factor(Description, levels = Description),
      direction   = ifelse(NES > 0,
                           paste(tissue_pos, "enriched"),
                           paste(tissue_neg, "enriched")),
      sig_label   = case_when(
        p.adjust < 0.001 ~ "***",
        p.adjust < 0.01  ~ "**",
        p.adjust < 0.05  ~ "*",
        TRUE             ~ ""
      )
    )

