# Rank: target tissue VST minus mean of all other tissues
make_ranked_list <- function(vst_df, target_tissue, all_tissues) {
  other_tissues <- base::setdiff(all_tissues, target_tissue)
  vst_df %>%
    rowwise() %>%
    dplyr::mutate(
      target_expr = get(target_tissue),
      other_mean  = mean(c_across(all_of(other_tissues)), na.rm = TRUE),
      rank_score  = target_expr - other_mean
    ) %>%
    dplyr::ungroup() %>%
    dplyr::filter(!is.na(rank_score)) %>%
    dplyr::arrange(desc(rank_score)) %>%
    dplyr::select(Gene_ID, rank_score)
}

make_ranked_psg_vs_asg <- function(vst_df) {
  vst_df %>%
    dplyr::mutate(rank_score = PSG - asg) %>%
    dplyr::filter(!is.na(rank_score)) %>%
    dplyr::arrange(desc(rank_score)) %>%
    dplyr::select(Gene_ID, rank_score)
}

ranked_lists <- list()
for (tis in tissues) {
  ranked_lists[[tis]] <- make_ranked_list(vst_clean, tis, tissues)
  cat(sprintf("  %-8s : %d genes ranked\n",
              tis, nrow(ranked_lists[[tis]])))
}
