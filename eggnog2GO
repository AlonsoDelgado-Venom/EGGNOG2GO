cat("\n=== Building ranked gene lists ===\n")

vst_clean <- as.data.frame(assay(vst_mat)) %>%
  rownames_to_column("Gene_ID")

# Rank score = target tissue VST - mean(all other tissues VST)
make_ranked_list <- function(vst_df, target_tissue, all_tissues) {
  other_tissues <- base::setdiff(all_tissues, target_tissue)
  vst_df %>%
    rowwise() %>%
    mutate(
      target_expr = get(target_tissue),
      other_mean  = mean(c_across(all_of(other_tissues)), na.rm = TRUE),
      rank_score  = target_expr - other_mean
    ) %>%
    ungroup() %>%
    filter(!is.na(rank_score)) %>%
    arrange(desc(rank_score)) %>%
    select(Gene_ID, rank_score)
}

# PSG vs ASG direct comparison
make_ranked_psg_vs_asg <- function(vst_df) {
  vst_df %>%
    mutate(rank_score = PSG - asg) %>%
    filter(!is.na(rank_score)) %>%
    arrange(desc(rank_score)) %>%
    select(Gene_ID, rank_score)
}

# Build ranked lists
ranked_lists <- list()
for (tis in tissues) {
  ranked_lists[[tis]] <- make_ranked_list(vst_clean, tis, tissues)
}
ranked_lists[["PSG_vs_ASG"]] <- make_ranked_psg_vs_asg(vst_clean)

# Convert to named numeric vectors
make_gsea_vector <- function(ranked_df) {
  vec <- ranked_df$rank_score
  names(vec) <- ranked_df$Gene_ID
  sort(vec, decreasing = TRUE)
}
gsea_vectors <- lapply(ranked_lists, make_gsea_vector)

for (nm in names(gsea_vectors)) {
  cat(sprintf("  %-12s : %d genes | top: %+.3f | bottom: %+.3f\n",
              nm, length(gsea_vectors[[nm]]),
              head(gsea_vectors[[nm]], 1),
              tail(gsea_vectors[[nm]], 1)))
}


