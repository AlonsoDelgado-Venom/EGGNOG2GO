# --- PLOT 2: NES Bar Charts ---

nes_barplot <- function(result, title,
                         tissue_pos = "PSG",
                         tissue_neg = "ASG",
                         n_show = 25, label_wrap = 45) {

  if (is.null(result) || nrow(as.data.frame(result)) == 0) return(NULL)

  df <- as.data.frame(result) %>%
    filter(p.adjust < 0.05) %>%
    arrange(NES)

  if (nrow(df) == 0) {
    message("  No significant terms (p.adj < 0.05): ", title)
    return(NULL)
  }

  n_neg <- min(n_show %/% 2, sum(df$NES < 0))
  n_pos <- min(n_show %/% 2, sum(df$NES > 0))
  df <- df %>%
    slice(c(1:n_neg, (nrow(.) - n_pos + 1):nrow(.))) %>%
    mutate(
      Description = str_wrap(Description, width = label_wrap),
      Description = factor(Description, levels = Description),
      direction   = ifelse(NES > 0,
                           paste(tissue_pos, "enriched"),
                           paste(tissue_neg, "enriched")),
      sig_label   = case_when(
        p.adjust < 0.001 ~ "***",
        p.adjust < 0.01  ~ "**",
        p.adjust < 0.05  ~ "*",
        TRUE             ~ ""
      )
    )

  ggplot(df, aes(x = NES, y = Description, fill = direction)) +
    geom_bar(stat = "identity", width = 0.7, alpha = 0.85) +
    geom_text(aes(label = sig_label,
                  x     = NES + ifelse(NES > 0, 0.05, -0.05)),
              hjust = ifelse(df$NES > 0, 0, 1), size = 4) +
    geom_vline(xintercept = 0, color = "black", linewidth = 0.5) +
    scale_fill_manual(
      values = setNames(c("darkred", "steelblue"),
                        c(paste(tissue_pos, "enriched"),
                          paste(tissue_neg, "enriched"))),
      name = NULL
    ) +
    theme_bw(base_size = 11) +
    labs(
      title    = title,
      subtitle = "* p<0.05  ** p<0.01  *** p<0.001 (BH-adjusted)",
      x        = "Normalized Enrichment Score (NES)",
      y        = NULL
    ) +
    theme(
      plot.title    = element_text(hjust = 0.5, face = "bold", size = 12),
      plot.subtitle = element_text(hjust = 0.5, size  = 9, color = "grey50"),
      axis.text.y   = element_text(size  = 9),
      legend.position = "top"
    )
}

