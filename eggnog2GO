            nrow(term2name_BP), nrow(term2gene_BP)))
cat(sprintf("GO MF: %d terms | %d gene-term pairs\n",
            nrow(term2name_MF), nrow(term2gene_MF)))
cat(sprintf("GO CC: %d terms | %d gene-term pairs\n",
