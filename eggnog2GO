# Tissue names must match kallisto output folder suffixes
# e.g. kallisto_out_asg/, kallisto_out_BM/, etc.
tissues <- c("asg", "BM", "PSG", "SU_ms", "arm", "eso")

# EggNOG file name mapping (eggnog suffix → kallisto name)
tissue_name_map <- data.frame(
  eggnog_name   = c("Arm", "ASG", "BM", "Esophagus",
                    "PSG", "Supraesophagous_mass"),
  kallisto_name = c("arm", "asg", "BM", "eso", "PSG", "SU_ms"),
  venom         = c(FALSE, TRUE,  FALSE, FALSE, TRUE,  FALSE)
)

# Standard EggNOG-mapper column names
eggnog_cols <- c(
  "Gene_ID", "seed_ortholog", "evalue", "score",
  "eggNOG_OGs", "max_annot_lvl", "COG_category",
  "Description", "Preferred_name", "GOs", "EC",
  "KEGG_ko", "KEGG_Pathway", "KEGG_Module",
