# ==============================================================
# WGCNA — TF Regulators of CRISP in T. pacificus
# Builds on existing DESeq2 pipeline output
# ==============================================================

# ── Libraries ─────────────────────────────────────────────────
library(WGCNA)
library(DESeq2)
library(dplyr)
library(tibble)
library(ggplot2)
library(ggrepel)
library(tidyr)
library(stringr)
library(igraph)
library(ggraph)
library(reshape2)
library(gridExtra)
library(viridis)

options(stringsAsFactors = FALSE)
enableWGCNAThreads()

# ==============================================================
# SECTION 1: Prepare Expression Matrix
# ==============================================================

# NOTE: vst_mat must be a DESeqTransform object from your
#       existing DESeq2 pipeline

vst_matrix <- assay(vst_mat)

cat(sprintf("VST matrix: %d genes x %d samples\n",
            nrow(vst_matrix), ncol(vst_matrix)))

# WGCNA requires: rows = samples, cols = genes
datExpr <- t(vst_matrix)

cat(sprintf("datExpr: %d samples x %d genes\n",
            nrow(datExpr), ncol(datExpr)))

# ==============================================================
# SECTION 2: Quality Control
# ==============================================================

gsg <- goodSamplesGenes(datExpr, verbose = 3)

if (!gsg$allOK) {
  if (sum(!gsg$goodGenes) > 0)
    cat(sprintf("Removing %d bad genes\n",   sum(!gsg$goodGenes)))
  if (sum(!gsg$goodSamples) > 0)
    cat(sprintf("Removing %d bad samples\n", sum(!gsg$goodSamples)))
  datExpr <- datExpr[gsg$goodSamples, gsg$goodGenes]
}

cat(sprintf("After QC: %d samples x %d genes\n",
            nrow(datExpr), ncol(datExpr)))

# Sample clustering — check for outliers
sampleTree <- hclust(dist(datExpr), method = "average")

pdf("WGCNA_sample_clustering.pdf", width = 8, height = 5)
par(cex = 1.0, mar = c(0, 4, 2, 0))
plot(sampleTree,
     main     = "Sample clustering — check for outliers",
     sub      = "",
     xlab     = "",
     cex.lab  = 1.5,
     cex.axis = 1.5,
     cex.main = 2)
dev.off()
cat("Saved: WGCNA_sample_clustering.pdf\n")

# ==============================================================
# SECTION 3: Soft Threshold Selection
# NOTE: With only 6 samples, R² < 0.80 is expected.
#       Power = 6 is used as fallback in that case.
# ==============================================================

powers <- 1:20

sft <- pickSoftThreshold(
  datExpr,
  powerVector = powers,
  networkType = "signed",
  verbose     = 5
)

pdf("WGCNA_soft_threshold.pdf", width = 10, height = 5)
par(mfrow = c(1, 2))

# Scale-free topology fit
plot(sft$fitIndices[, 1],
     -sign(sft$fitIndices[, 3]) * sft$fitIndices[, 2],
     xlab = "Soft Threshold (power)",
     ylab = "Scale Free Topology R²",
     main = "Scale independence",
     type = "n")
text(sft$fitIndices[, 1],
     -sign(sft$fitIndices[, 3]) * sft$fitIndices[, 2],
     labels = powers, col = "red")
abline(h = 0.80, col = "red")

# Mean connectivity
plot(sft$fitIndices[, 1],
     sft$fitIndices[, 5],
     xlab = "Soft Threshold (power)",
     ylab = "Mean Connectivity",
     main = "Mean connectivity",
     type = "n")
text(sft$fitIndices[, 1],
     sft$fitIndices[, 5],
     labels = powers, col = "red")
dev.off()
cat("Saved: WGCNA_soft_threshold.pdf\n")

# Choose first power where R² > 0.80
chosen_power <- sft$fitIndices %>%
  as.data.frame() %>%
  mutate(fit = -sign(SFT.R.sq) * slope) %>%
  filter(fit > 0.80) %>%
  slice(1) %>%
  pull(Power)

if (length(chosen_power) == 0) {
  chosen_power <- 6
  cat("WARNING: R² < 0.80 — using power = 6\n")
  cat("This is expected with only 6 samples\n")
} else {
  cat(sprintf("Chosen soft power: %d\n", chosen_power))
}

# ==============================================================
# SECTION 4: Build Network
# ==============================================================

# Force WGCNA::cor to avoid conflicts with stats::cor
cor <- WGCNA::cor

net <- blockwiseModules(
  datExpr,
  power             = chosen_power,
  networkType       = "signed",
  TOMType           = "signed",
  minModuleSize     = 15,
  mergeCutHeight    = 0.25,
  numericLabels     = TRUE,
  pamRespectsDendro = FALSE,
  saveTOMs          = TRUE,
  saveTOMFileBase   = "WGCNA_TOM",
  maxBlockSize      = 10000,
  verbose           = 3,
  randomSeed        = 42
)

rm(cor)   # Restore default cor

# Module summary
moduleColors  <- labels2colors(net$colors)
table_modules <- table(moduleColors)

cat("\nModule summary:\n")
print(table_modules)
cat(sprintf("Total modules detected: %d\n",
            length(unique(net$colors)) - 1))

# Save module assignments
module_df <- data.frame(
  Gene_ID      = colnames(datExpr),
  module_num   = net$colors,
  module_color = moduleColors,
  stringsAsFactors = FALSE
)

write.csv(module_df,
          "WGCNA_gene_module_assignments.csv",
          row.names = FALSE)
cat("Saved: WGCNA_gene_module_assignments.csv\n")

# ==============================================================
# SECTION 5: Module Eigengenes & Trait Correlations
# ==============================================================

cat("\n=== Module Eigengenes ===\n")

MEs_unordered <- moduleEigengenes(datExpr, moduleColors)$eigengenes
MEs           <- orderMEs(MEs_unordered)

# Binary tissue trait matrix (1 = is that tissue, 0 = not)
trait_matrix <- matrix(0,
                       nrow = nrow(datExpr),
                       ncol = length(tissues))
rownames(trait_matrix) <- rownames(datExpr)
colnames(trait_matrix) <- tissues

for (tis in tissues) {
  if (tis %in% rownames(trait_matrix))
    trait_matrix[tis, tis] <- 1
}

trait_df <- as.data.frame(trait_matrix)

# Correlate eigengenes with tissue traits
cor <- WGCNA::cor
moduleTraitCor <- WGCNA::cor(MEs, trait_df,
                              use = "pairwise.complete.obs")
rm(cor)

moduleTraitPvalue <- corPvalueStudent(moduleTraitCor,
                                      nrow(datExpr))

# Heatmap of module-trait relationships
pdf("WGCNA_module_trait_heatmap.pdf",
    width  = 10,
    height = max(6, nrow(moduleTraitCor) * 0.3))

textMatrix <- paste(signif(moduleTraitCor, 2), "\n(",
                    signif(moduleTraitPvalue, 1), ")",
                    sep = "")
dim(textMatrix) <- dim(moduleTraitCor)

par(mar = c(6, 8.5, 3, 3))
labeledHeatmap(
  Matrix        = moduleTraitCor,
  xLabels       = colnames(trait_df),
  yLabels       = names(MEs),
  ySymbols      = names(MEs),
  colorLabels   = FALSE,
  colors        = blueWhiteRed(50),
  textMatrix    = textMatrix,
  setStdMargins = FALSE,
  cex.text      = 0.5,
  zlim          = c(-1, 1),
  main          = "Module-tissue relationships"
)
dev.off()
cat("Saved: WGCNA_module_trait_heatmap.pdf\n")

# Modules correlated with PSG
psg_module_cors <- data.frame(
  module   = gsub("ME", "", rownames(moduleTraitCor)),
  PSG_cor  = moduleTraitCor[, "PSG"],
  PSG_pval = moduleTraitPvalue[, "PSG"]
) %>%
  arrange(desc(abs(PSG_cor)))

cat("\nTop modules correlated with PSG:\n")
print(head(psg_module_cors, 10))

**************************************************************

# ============================================
# PART 1: SETUP & ANNOTATION LOOKUP
# ============================================

# Find top co-expressed genes with PLB hub
top_gene_names <- names(top_coexpr_plb)

# Annotate top co-expressed genes
top_annotated <- eggnog_final[eggnog_final$Gene_ID %in% top_gene_names, 
                               c("Gene_ID", "Description", "Preferred_name", 
                                 "COG_category", "PFAMs", "GOs")]
head(top_annotated, 20)

# ============================================
# PART 2: IDENTIFY TF CANDIDATES
# ============================================

# 1. COG category "K" = Transcription
tf_cog <- top_annotated[grepl("K", top_annotated$COG_category), ]

# 2. TF-related keywords in Description
tf_desc <- top_annotated[grepl(
  "transcription|zinc finger|homeobox|helix|
   nuclear receptor|DNA binding|
   GATA|bHLH|bZIP|Myb|Fox|Sox|Hox", 
  top_annotated$Description, 
  ignore.case = TRUE), ]

# 3. TF-related PFAMs
tf_pfam <- top_annotated[grepl(
  "zf-|Homeobox|HLH|bZIP|GATA|
   Myb|Forkhead|Nuclear|RHD|
   p53|ETS|SAND|PHD", 
  top_annotated$PFAMs, 
  ignore.case = TRUE), ]

# Combine all TF candidates
tf_candidates <- unique(rbind(tf_cog, tf_desc, tf_pfam))

# Add correlation values
tf_candidates$correlation <- top_coexpr_plb[tf_candidates$Gene_ID]
tf_candidates <- tf_candidates[order(tf_candidates$correlation, 
                                      decreasing = TRUE), ]
print(tf_candidates)

# Add TF type labels
tf_candidates$TF_type <- c(
  "C2H2 Zinc Finger TF",
  "Zinc Finger TF (isoform?)",
  "Zinc Finger TF (isoform?)",
  "Transcription Elongation",
  "Epigenetic Regulator",
  "Chromatin Remodeling"
)

# ============================================
# PART 3: HUB GENE ANNOTATION & EXPRESSION
# ============================================

# Hub gene ID
plb_gene_id  # "TRINITY_DN3073_c0_g2"

# Annotate hub gene
hub_annotation <- eggnog_final[eggnog_final$Gene_ID == plb_gene_id,
                                c("Gene_ID", "Description", "Preferred_name",
                                  "COG_category", "KEGG_ko", "KEGG_Pathway",
                                  "PFAMs", "GOs")]
print(hub_annotation)

# Hub gene tissue expression
hub_expr_vec <- vst_matrix[plb_gene_id, 1:6]
hub_tissue_df <- data.frame(
  tissue = c("ASG", "BM", "PSG", "SU_ms", "ARM", "ESO"),
  VST    = as.numeric(hub_expr_vec)
)
print(hub_tissue_df)

# ============================================
# PART 4: MODULE ASSIGNMENTS
# ============================================

# Hub gene module
hub_module <- module_df[module_df$Gene_ID == plb_gene_id, 
                         "module_color"]
cat("Hub gene module:", hub_module, "\n")

# PLB family module assignments
plb_module_info <- module_df[module_df$Gene_ID %in% plb_ids,
                              c("Gene_ID", "module_color", "module_num")]
print(plb_module_info)

# TF candidates module assignments
tf_module_info <- module_df[module_df$Gene_ID %in% tf_candidates$Gene_ID,
                             c("Gene_ID", "module_color", "module_num")]
print(tf_module_info)

# How many genes in yellow module?
hub_module_genes <- module_df[module_df$module_color == hub_module, 
                               "Gene_ID"]
cat("Yellow module size:", length(hub_module_genes), "\n")

# ============================================
# PART 5: kME VALUES
# ============================================

# Hub gene kME
cat("Hub kME:", kME_df[kME_df$Gene_ID == plb_gene_id, "kME"], "\n")

# TF candidates kME
tf_kme <- kME_df[kME_df$Gene_ID %in% tf_candidates$Gene_ID,
                  c("Gene_ID", "kME")]
tf_kme <- merge(tf_kme,
                tf_candidates[, c("Gene_ID", "TF_type", "correlation")],
                by = "Gene_ID")
tf_kme <- tf_kme[order(tf_kme$kME, decreasing = TRUE), ]
print(tf_kme)

# ============================================
# PART 6: TF COMPLETE TABLE
# ============================================

# Add module info to TF candidates
tf_complete <- merge(
  tf_kme,
  tf_module_info[, c("Gene_ID", "module_color", "module_num")],
  by = "Gene_ID"
)

# Add tissue expression from coexpr_df
tf_complete <- merge(
  tf_complete,
  coexpr_df[, c("Gene_ID", "PSG_VST", "ASG_VST",
                 "BM_VST", "SU_VST", "ARM_VST", "ESO_VST",
                 "psg_log2fc", "psg_vs_max")],
  by = "Gene_ID",
  all.x = TRUE
)

tf_complete <- tf_complete[order(tf_complete$correlation,
                                  decreasing = TRUE), ]

# Add PSG vs ASG difference
tf_complete$PSG_vs_ASG <- tf_complete$PSG_VST - tf_complete$ASG_VST

# Add clean labels
tf_complete$label <- case_when(
  tf_complete$Gene_ID == "TRINITY_DN26905_c0_g1" ~ "C2H2 Zinc Finger",
  tf_complete$Gene_ID == "TRINITY_DN16812_c2_g1" ~ "ZF214 (paralog A)",
  tf_complete$Gene_ID == "TRINITY_DN17677_c0_g1" ~ "ZF214 (paralog B)",
  tf_complete$Gene_ID == "TRINITY_DN3879_c2_g1"  ~ "Tx Elongation Factor",
  tf_complete$Gene_ID == "TRINITY_DN27818_c0_g1" ~ "Sirt2 (HDAC)",
  tf_complete$Gene_ID == "TRINITY_DN26358_c0_g1" ~ "WD40 Chromatin"
)

tf_complete$module_label <- ifelse(
  tf_complete$module_color == "yellow",
  "Same module as PLB",
  "Cross-module regulator")

print(tf_complete)

# ============================================
# PART 7: PLB FAMILY
# ============================================

# PLB family members
plb_ids <- plb_in_vst$Gene_ID

# PLB family correlations with hub
