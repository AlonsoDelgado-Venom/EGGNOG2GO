       subtitle = "Phospholipase B | Venom enzyme",
       x = NULL,
       y = "VST Expression") +
  theme_bw(base_size = 12) +
  theme(plot.title    = element_text(face = "bold", size = 12),
        plot.subtitle = element_text(size = 10, color = "gray40"),
        axis.text.y   = element_text(size = 11)) +
