)

# PSG vs ASG difference
tf_psg_summary <- tf_with_tissue[, c("Gene_ID", "TF_type",
                                      "correlation",
                                      "PSG_VST", "ASG_VST",
                                      "psg_log2fc", "psg_vs_max")]
tf_psg_summary$PSG_vs_ASG <- tf_psg_summary$PSG_VST -
